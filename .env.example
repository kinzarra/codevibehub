POSTGRES_DSN=postgresql+asyncpg://user:password@localhost:5432/vibecode

# Hetzner Object Storage (аватары/фото мероприятий). Локация бакета — hel1.
S3_ENDPOINT_URL=https://hel1.your-objectstorage.com
S3_REGION=hel1
S3_AVATAR_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Вход и создание мероприятий (Google). Без этих переменных /login и /events/new отвечают 404.
PUBLIC_BASE_URL=http://localhost:8000
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=

# Google Analytics 4: Admin → Data streams → Measurement ID. Пусто — аналитика выключена.
GA_MEASUREMENT_ID=

# Уведомления в Telegram: токен бота от @BotFather и id чата (личка, группа или канал с ботом). Пусто — выключено.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
